+_WINDOWS_HARDLINK_CMD = " ".join([
+    "$ErrorActionPreference = 'Stop'; Set-Location -LiteralPath ([Environment]::CurrentDirectory);",
+    "Get-ChildItem -LiteralPath bin -Force -File -Attributes ReparsePoint |",
+    "Where-Object { $_.LinkType -eq 'SymbolicLink' } |",
+    "ForEach-Object {",
+    "$t0 = @($_.Target)[0];",
+    "$t = if ([IO.Path]::IsPathRooted($t0)) { $t0 } else { [IO.Path]::GetFullPath((Join-Path $_.DirectoryName $t0)) };",
+    "if (-not (Test-Path -LiteralPath $t -PathType Leaf)) { throw ('Symlink target not found: ' + $t) };",
+    "Remove-Item -LiteralPath $_.FullName -Force;",
+    "New-Item -ItemType HardLink -Path $_.FullName -Target $t | Out-Null",
+    "};",
+    "$left = @(Get-ChildItem -LiteralPath bin -Force -File -Attributes ReparsePoint | Where-Object { $_.LinkType -eq 'SymbolicLink' });",
+    "if ($left.Count) { throw ('Symlinks left: ' + ($left.FullName -join ', ')) }",
+])
+
 def _llvm_toolchain_minimal_impl(module_ctx):
